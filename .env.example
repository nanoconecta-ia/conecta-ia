# Somente NOMES de variáveis. Nunca coloque valores reais neste arquivo nem no repositório.
# Valores reais ficam no provedor de hospedagem / cofre de segredos.

# Supabase (projeto conecta-ia)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave de serviço: SOMENTE no servidor, nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Entrada do agente NanoShell: guardar apenas o HASH das chaves por loja no banco.
INGEST_KEY_PEPPER=

# Idade máxima (minutos) do sinal de vida do agente para permitir checkout.
FRESCOR_MAX_MINUTOS=15

# Indexador nativo (modo nativo): app OAuth do Bling registrado para o Conecta.IA.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# Chave que cifra as credenciais do Bling de cada cliente no banco. Só no servidor.
CREDENCIAIS_CHAVE_CIFRA=

# App web (web/)
# URL pública do app, usada nos retornos de login e nos links de produto.
APP_URL=
