{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanoia-codemode-piloto-nao-publicar",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": { "PILOT_ENABLED": "false" },
  "worker_loaders": [{ "binding": "LOADER" }],
  "services": [{ "binding": "PILOT_HOST_SERVICE", "service": "nanoia-codemode-host-fixture-nao-publicar" }]
}
