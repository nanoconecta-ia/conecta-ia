{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "nanoia-codemode-hml-host",
  "main": "host.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "REPLAY_AUDITORIA",
        "class_name": "ReplayAuditoriaHml"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ReplayAuditoriaHml"
      ]
    }
  ]
}
